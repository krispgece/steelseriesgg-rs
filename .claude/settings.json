{
  "permissions": {
    "allow": [
      "Bash(git fetch origin *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo tree *)",
      "Bash(cargo audit *)",
      "Bash(rg *)",
      "Bash(tshark *)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(rg *--pre*)",
      "Bash(tshark *-X*)",
      "Bash(git fetch *--upl*)",
      "Bash(*ssgg* onboard write*)",
      "Bash(cargo run* onboard write*)",
      "Bash(*ssgg* onboard load*)",
      "Bash(cargo run* onboard load*)",
      "Bash(*ssgg* onboard gen3-write*)",
      "Bash(cargo run* onboard gen3-write*)",
      "Bash(*ssgg* onboard gen3-restore*)",
      "Bash(cargo run* onboard gen3-restore*)",
      "Bash(*ssgg* onboard gen3-activate*)",
      "Bash(cargo run* onboard gen3-activate*)",
      "Bash(*ssgg* device region*)",
      "Bash(cargo run* device region*)",
      "Bash(*ssgg* device meta-key*)",
      "Bash(cargo run* device meta-key*)",
      "Bash(*ssgg* keymap set*)",
      "Bash(cargo run* keymap set*)",
      "Bash(*ssgg* keymap reset*)",
      "Bash(cargo run* keymap reset*)",
      "Bash(*ssgg* actuation *)",
      "Bash(cargo run* actuation *)",
      "Bash(*ssgg* oled show*--onboard*)",
      "Bash(cargo run* oled show*--onboard*)",
      "Bash(*ssgg* fuzz*)",
      "Bash(cargo run* fuzz*)",
      "Bash(*ssgg* mouse dpi*)",
      "Bash(cargo run* mouse dpi*)",
      "Bash(*cargo *--bin*discover_actuation*)",
      "Bash(*target/*/discover_actuation*)",
      "Bash(*cargo *--bin*verify_key_mapping*)",
      "Bash(*target/*/verify_key_mapping*)",
      "Bash(discover_actuation*)",
      "Bash(*./discover_actuation*)",
      "Bash(verify_key_mapping*)",
      "Bash(*./verify_key_mapping*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(*ssgg* onboard write*)",
      "PowerShell(cargo run* onboard write*)",
      "PowerShell(*ssgg* onboard load*)",
      "PowerShell(cargo run* onboard load*)",
      "PowerShell(*ssgg* onboard gen3-write*)",
      "PowerShell(cargo run* onboard gen3-write*)",
      "PowerShell(*ssgg* onboard gen3-restore*)",
      "PowerShell(cargo run* onboard gen3-restore*)",
      "PowerShell(*ssgg* onboard gen3-activate*)",
      "PowerShell(cargo run* onboard gen3-activate*)",
      "PowerShell(*ssgg* device region*)",
      "PowerShell(cargo run* device region*)",
      "PowerShell(*ssgg* device meta-key*)",
      "PowerShell(cargo run* device meta-key*)",
      "PowerShell(*ssgg* keymap set*)",
      "PowerShell(cargo run* keymap set*)",
      "PowerShell(*ssgg* keymap reset*)",
      "PowerShell(cargo run* keymap reset*)",
      "PowerShell(*ssgg* actuation *)",
      "PowerShell(cargo run* actuation *)",
      "PowerShell(*ssgg* oled show*--onboard*)",
      "PowerShell(cargo run* oled show*--onboard*)",
      "PowerShell(*ssgg* fuzz*)",
      "PowerShell(cargo run* fuzz*)",
      "PowerShell(*ssgg* mouse dpi*)",
      "PowerShell(cargo run* mouse dpi*)",
      "PowerShell(*cargo *--bin*discover_actuation*)",
      "PowerShell(*target*discover_actuation*)",
      "PowerShell(*cargo *--bin*verify_key_mapping*)",
      "PowerShell(*target*verify_key_mapping*)",
      "PowerShell(discover_actuation*)",
      "PowerShell(*.\\discover_actuation*)",
      "PowerShell(verify_key_mapping*)",
      "PowerShell(*.\\verify_key_mapping*)"
    ],
    "deny": [
      "Bash(git *push* --force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "Bash(git *push* -uf*)",
      "Bash(git *push* -vf*)",
      "Bash(git *push* -qf*)",
      "Bash(git *push* --mi*)",
      "Bash(git *push*=+*)",
      "PowerShell(git *push* --force*)",
      "PowerShell(git *push* -f*)",
      "PowerShell(git *push* +*)",
      "PowerShell(git *push* -uf*)",
      "PowerShell(git *push* -vf*)",
      "PowerShell(git *push* -qf*)",
      "PowerShell(git *push* --mi*)",
      "PowerShell(git *push*=+*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *push*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind.sh\" git-push"
          },
          {
            "type": "command",
            "if": "PowerShell(git *push*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind.sh\" git-push"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rs-post-edit.sh\""
          },
          {
            "type": "command",
            "if": "Edit(*Cargo.toml)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-check.sh\" pin"
          },
          {
            "type": "command",
            "if": "Write(*Cargo.toml)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-check.sh\" pin"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-check.sh\" build",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
